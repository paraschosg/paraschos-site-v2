# Contact form → email delivery via Resend (https://resend.com). Free tier is enough.
RESEND_API_KEY=
CONTACT_TO=george@paraschos.site
# Optional: raises GitHub API rate limit from 60/h to 5000/h. Read-only, no scopes needed.
GITHUB_TOKEN=
# Optional: shared rate limiting across serverless instances (https://upstash.com, free tier).
# Without these the contact form falls back to a per-instance counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
